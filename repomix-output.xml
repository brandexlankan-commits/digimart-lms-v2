      }
    } catch (error) {
      console.error("Slip upload error:", error);
      alert("⚠️ සේවාදායකයේ දෝෂයකි. කරුණාකර නැවත උත්සාහ කරන්න.");
    } finally {
      setUploading(false);
    }
  };

  const isPdf = slipFile?.type === "application/pdf" || slipFile?.name.toLowerCase().endsWith(".pdf");

  return (
